<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500&display=swap');

  .chatbot-container {
    background: white;
    border-radius: 8px;
    overflow: visible;
    border: 1px solid #E4E4E4;
    font-family: 'Poppins', sans-serif;
    padding: 10px;
    min-height: 400px;
    box-sizing: border-box;
  }

  .chatbot-text-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
  }


  .chatbot-title {
    color: #0A62A9;
    font-size: 16px;
    font-weight: 500;
  }

  .chatbot-subtitle {
    font-size: 10px;
    font-weight: 400;
  }

  #chatbot-area {
    background: #F9FAFB;
    height: 250px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    overflow-y: auto;
    min-height: 400px;
    box-sizing: border-box;
  }

  .chat-message {
    max-width: 70%;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.5;
    position: relative;
    animation: fadeIn 0.3s ease-in;
  }

  .user-message {
    background: #0A62A9;
    color: white;
    margin-left: auto;
    border-radius: 8px 8px 0 8px;
  }

  .user-message::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 12px;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-left-color: #0A62A9;
    border-right: 0;
  }

  .bot-message {
    background: white;
    color: #333;
    border: 1px solid #E4E4E4;
    margin-right: auto;
    border-radius: 8px 8px 8px 0;
  }

  .bot-message::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 12px;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-right-color: #E4E4E4;
    border-left: 0;
  }

  .bot-message::after {
    content: '';
    position: absolute;
    left: -5px;
    top: 12px;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-right-color: white;
    border-left: 0;
  }

  .reference {
    font-size: 12px;
    color: #666;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #eee;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chatbot-input-wrapper {
    background: white;
    border-radius: 8px;
    border: 1px solid #E4E4E4;
    padding: 8px;
  }

  .chatbot-cta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .chatbot-icons {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .icon-attach,
  .icon-ai {
    width: 24px;
    height: 24px;
    opacity: 0.5;
  }

  .chatbot-input {
    flex: 1;
    padding: 8px 12px;
