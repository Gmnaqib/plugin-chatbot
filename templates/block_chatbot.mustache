    outline: none;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    color: #333;
    min-width: 0;
  }

  .chatbot-submit {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0A62A9;
    border: none;
    cursor: pointer;
    border-radius: 8px;
  }

  .chatbot-submit svg {
    pointer-events: none;
  }

  .chatbot-image {
    max-width: 30%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .chatbot-cta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .icon-wrapper {
    position: relative;
    cursor: pointer;
    display: inline-block;
    z-index: 20;
  }

  .icon-wrapper:hover::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(51, 51, 51, 0.9);
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    font-family: 'Poppins', sans-serif;
    margin-bottom: 5px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
    z-index: 99;
  }

  .icon-wrapper:hover::after {
    opacity: 1;
    transition-delay: 0s;
  }

  .chatbot-file {
    display: inline-flex;
    position: relative;
  }

  .chatbot-file-icon {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 500;
    color: #161616;
    background: #E3F0FF;
    padding: 4px 6px;
    border-radius: 6px;
  }

  .chatbot-file-close {
    cursor: pointer;
    position: absolute;
    top: -8px;
    right: -5px;
  }

