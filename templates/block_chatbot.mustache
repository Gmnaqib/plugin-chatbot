    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #eee;
  }

  .sidebar-close {
    font-size: 24px;
    cursor: pointer;
    color: #666;
  }

  .sidebar-content {
    padding: 1rem;
  }

