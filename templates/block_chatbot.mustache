  .prompt-sidebar.active {
    right: 0;
  }

  .prompt-sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: 0.3s ease-in-out;
    pointer-events: none;
    z-index: 9998;
