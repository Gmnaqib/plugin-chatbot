    padding: 0.5rem 1rem;
    cursor: pointer;
    position: relative;
  }

  .pl-tab.active {
    color: #0A62A9;
  }

  .pl-active-indicator {
    position: absolute;
    bottom: 0;
    left: 0px;
    width: 106px;
    height: 3px;
    background: #0A62A9;
    border-radius: 12px;
    transition: 0.3s ease;
  }

  .pl-search {
